.community-actions { display: flex; gap: 12px; }
.community-action { display: inline-flex; align-items: center; gap: 6px; background: none; border: 1px solid var(--border); color: var(--muted); padding: 6px 10px; border-radius: 16px; cursor: pointer; font-size: 12px; }
