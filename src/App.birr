<template>
  <div class="os" data-theme="{{ theme }}">
    <div class="status-bar">
      <span class="status-time">{{ clockTime }}</span>
      <span class="status-date">{{ hijriDate }}</span>
      <span class="status-prayer" birr:if="nextPrayer">{{ nextPrayer }}</span>
    </div>

    <div birr:if="activeApp === null" class="home-screen">
      <div class="home-header">
        <p class="home-greeting">{{ greeting }}</p>
        <p class="home-bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
      </div>

      <div class="prayer-widget" birr:if="prayerTimes">
        <div class="prayer-widget-label">Next Prayer</div>
        <div class="prayer-widget-name">{{ nextPrayerName }}</div>
        <div class="prayer-widget-time">{{ nextPrayerTime }}</div>
        <div class="prayer-widget-countdown">{{ prayerCountdown }}</div>
      </div>

      <div class="category-tabs">
        <button birr:for="cat in categories" birr:key="cat.id" class="cat-tab {{ activeCategoryClass(cat.id) }}" birr:on:click="setCategory(cat.id)">
          {{ cat.name }}
        </button>
      </div>

      <div class="app-grid">
        <button birr:for="app in filteredApps" birr:key="app.id" class="app-icon" birr:on:click="openApp(app.id)">
          <div class="app-icon-circle" style="background: {{ app.color }}">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="{{ app.icon }}" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="app-icon-label">{{ app.name }}</span>
        </button>
      </div>

      <div class="dock">
        <button class="dock-item" birr:on:click="openApp('quran')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="dock-item" birr:on:click="openApp('prayer')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="dock-item" birr:on:click="openApp('qibla')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 16l-4-4h8l-4 4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="dock-item" birr:on:click="openApp('tasbih')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a6 6 0 110 12 6 6 0 010-12z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="dock-item" birr:on:click="toggleTheme">
          <svg birr:if="isLight" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg birr:if="isDark" width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>

    <div birr:if="activeApp !== null" class="app-viewer">
      <div class="app-header">
        <button class="app-back" birr:on:click="closeApp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <h2 class="app-title">{{ activeAppName }}</h2>
      </div>
      <div class="app-content" id="app-content-{{ activeApp }}"></div>
    </div>
  </div>
</template>

<script>
import { signal, computed, effect } from 'birrstack-core';
import { APPS, CATEGORIES } from './data/apps';
import { getThemeSignal, toggleTheme } from './lib/theme';
import { getPrayerTimes, getHijriDate } from './data/prayer';

export default {
  setup() {
    const theme = getThemeSignal();
    const isLight = computed(() => theme.value === 'light');
    const isDark = computed(() => theme.value === 'dark');

    const activeApp = signal(null);
    const activeAppName = computed(() => {
      if (!activeApp.value) return '';
      const app = APPS.find(a => a.id === activeApp.value);
      return app ? app.name : '';
    });

    const activeCategory = signal('ibadah');
    const categories = CATEGORIES;
    const filteredApps = computed(() => APPS.filter(a => a.category === activeCategory.value));

    function activeCategoryClass(catId) {
      return activeCategory.value === catId ? 'cat-active' : '';
    }
    function setCategory(catId) { activeCategory.value = catId; }

    function openApp(appId) { activeApp.value = appId; }
    function closeApp() { activeApp.value = null; }

    // Clock
    const now = signal(new Date());
    setInterval(() => { now.value = new Date(); }, 1000);
    const clockTime = computed(() => {
      const d = now.value;
      const h = d.getHours();
      const m = String(d.getMinutes()).padStart(2, '0');
      const ampm = h >= 12 ? 'PM' : 'AM';
      const h12 = h % 12 || 12;
      return `${h12}:${m} ${ampm}`;
    });

    // Greeting
    const greeting = computed(() => {
      const h = now.value.getHours();
      if (h < 12) return 'Good morning';
      if (h < 16) return 'Good afternoon';
      if (h < 20) return 'Good evening';
      return 'Good night';
    });

    // Hijri date
    const hijriDate = signal('');
    async function updateHijriDate() {
      try { hijriDate.value = await getHijriDate(); }
      catch { hijriDate.value = now.value.toLocaleDateString(); }
    }
    updateHijriDate();
    setInterval(updateHijriDate, 3600000);

    // Prayer times
    const prayerTimes = signal(null);
    const nextPrayerName = signal('');
    const nextPrayerTime = signal('');
    const nextPrayer = computed(() => prayerTimes.value ? `${nextPrayerName.value} ${nextPrayerTime.value}` : '');
    const prayerCountdown = signal('');

    async function loadPrayerTimes() {
      try {
        const pt = await getPrayerTimes();
        prayerTimes.value = pt;
        // Find next prayer
        const prayers = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];
        const times = [pt.fajr, pt.dhuhr, pt.asr, pt.maghrib, pt.isha];
        const current = new Date();
        for (let i = 0; i < prayers.length; i++) {
          const [h, m] = times[i].split(':').map(Number);
          const prayerDate = new Date();
          prayerDate.setHours(h, m, 0, 0);
          if (prayerDate > current) {
            nextPrayerName.value = prayers[i];
            nextPrayerTime.value = times[i];
            const diff = prayerDate - current;
            const hours = Math.floor(diff / 3600000);
            const mins = Math.floor((diff % 3600000) / 60000);
            prayerCountdown.value = `in ${hours}h ${mins}m`;
            return;
          }
        }
        // Next prayer is Fajr tomorrow
        nextPrayerName.value = 'Fajr';
        nextPrayerTime.value = pt.fajr;
        prayerCountdown.value = 'tomorrow';
      } catch { prayerTimes.value = null; }
    }
    loadPrayerTimes();
    setInterval(loadPrayerTimes, 60000);

    return {
      theme, isLight, isDark, toggleTheme,
      activeApp, activeAppName, openApp, closeApp,
      activeCategory, categories, filteredApps, activeCategoryClass, setCategory,
      clockTime, greeting, hijriDate,
      prayerTimes, nextPrayerName, nextPrayerTime, nextPrayer, prayerCountdown,
    };
  },
};
</script>

<style scoped>
.os { min-height: 100vh; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; --bg: #E9FBF1; --text: #181F25; --surface: #FFFFFF; --primary: #05B34D; --accent: #F2B91C; --border: #d1e8db; --muted: #5a6c6a; }
.os[data-theme="dark"] { --bg: #181F25; --text: #E9FBF1; --surface: #232b32; --primary: #05B34D; --accent: #F2B91C; --border: #2d3a44; --muted: #8898a0; }
.status-bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 16px; background: var(--surface); border-bottom: 1px solid var(--border); font-size: 12px; color: var(--text); position: sticky; top: 0; z-index: 100; }
.status-time { font-weight: 700; }
.status-date { color: var(--muted); }
.status-prayer { color: var(--primary); font-weight: 600; }
.home-screen { padding: 16px; padding-bottom: 80px; max-width: 600px; margin: 0 auto; }
.home-header { text-align: center; margin-bottom: 24px; }
.home-greeting { font-size: 18px; color: var(--muted); margin: 0; }
.home-bismillah { font-size: 20px; color: var(--primary); margin: 8px 0 0 0; font-weight: 600; }
.prayer-widget { background: linear-gradient(135deg, var(--primary), #04a045); color: white; border-radius: 16px; padding: 20px; text-align: center; margin-bottom: 24px; }
.prayer-widget-label { font-size: 12px; opacity: 0.9; text-transform: uppercase; letter-spacing: 1px; }
.prayer-widget-name { font-size: 24px; font-weight: 700; margin: 4px 0; }
.prayer-widget-time { font-size: 32px; font-weight: 700; }
.prayer-widget-countdown { font-size: 13px; opacity: 0.9; margin-top: 4px; }
.category-tabs { display: flex; gap: 8px; margin-bottom: 16px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.cat-tab { background: var(--surface); border: 1px solid var(--border); color: var(--muted); padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; white-space: nowrap; cursor: pointer; }
.cat-active { background: var(--primary); color: white; border-color: var(--primary); }
.app-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
.app-icon { background: none; border: none; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 4px; }
.app-icon-circle { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; transition: transform 0.1s ease; }
.app-icon:active .app-icon-circle { transform: scale(0.9); }
.app-icon-label { font-size: 11px; color: var(--text); text-align: center; font-weight: 500; }
.dock { position: fixed; bottom: 0; left: 0; right: 0; background: var(--surface); border-top: 1px solid var(--border); display: flex; justify-content: space-around; padding: 8px 16px; max-width: 600px; margin: 0 auto; z-index: 100; }
.dock-item { background: none; border: none; color: var(--primary); cursor: pointer; padding: 8px 16px; border-radius: 12px; }
.dock-item:active { background: var(--border); }
.app-viewer { min-height: 100vh; display: flex; flex-direction: column; }
.app-header { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
.app-back { background: none; border: none; color: var(--text); cursor: pointer; padding: 8px; }
.app-title { font-size: 18px; font-weight: 700; margin: 0; color: var(--text); }
.app-content { flex: 1; padding: 16px; max-width: 600px; margin: 0 auto; width: 100%; box-sizing: border-box; padding-bottom: 80px; }
</style>
