.place-type { font-size: 11px; color: var(--primary); margin: 0 0 2px 0; }
.place-address { font-size: 11px; color: var(--muted); margin: 0; }
.place-directions { color: var(--primary); padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; }

/* Settings */
.settings-section { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 12px; }
.settings-section-title { font-size: 13px; font-weight: 700; margin: 0 0 12px 0; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
.settings-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; font-size: 14px; color: var(--text); }
.settings-toggle { display: inline-flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; }
.settings-font-row { display: flex; gap: 6px; }
.settings-font-active { background: var(--primary); color: white; border-color: var(--primary); }
