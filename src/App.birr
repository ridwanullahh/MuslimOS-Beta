.audio-playlist { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 12px; }
.audio-playlist-title { font-size: 13px; font-weight: 700; margin: 0 0 10px 0; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
.audio-track { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 8px; cursor: pointer; border: none; background: none; width: 100%; text-align: left; color: var(--text); }
.audio-track:active { background: var(--border); }
.audio-track-active { background: rgba(5,179,77,0.1); }
.audio-track-num { background: var(--primary); color: white; width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
.audio-track-name { font-size: 13px; }

/* Places (Mosque + Halal) */
.places-header { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.places-intro { font-size: 12px; color: var(--muted); margin: 0; }
